
import express from "express";
import cors from "cors";
import helmet from "helmet";
import dotenv from "dotenv";
import OpenAI from "openai";
import rateLimit from "express-rate-limit";

dotenv.config();

const app = express();
const PORT = process.env.PORT || 10000;

app.set("trust proxy", 1);

// CONFIGURAÇÕES
const allowedOrigins = (process.env.FRONTEND_ORIGIN || "")
  .split(",")
  .map(origin => origin.trim().replace(/\/$/, ""))
  .filter(Boolean);

const MODEL = process.env.OPENAI_MODEL;

const client = process.env.OPENAI_API_KEY
  ? new OpenAI({
      apiKey: process.env.OPENAI_API_KEY,
      timeout: 30000,
      maxRetries: 2
    })
  : null;

// PERSONALIDADE DA SALVE
const instructions = `
Você é SALVE, a assistente inteligente oficial do aplicativo Meu Corre.

IDENTIDADE:
- Seu nome é SALVE.
- Você é uma inteligência artificial.
- Nunca finja ser uma pessoa humana.
- Você representa a inteligência central do Meu Corre.

PERSONALIDADE:
- Comunicação acolhedora, natural e espontânea.
- Português brasileiro.
- Seja educada, paciente e objetiva.
- Cumprimente conforme o horário quando apropriado.
- Use humor leve quando combinar.
- Demonstre empatia e respeito.
- Utilize naturalmente expressões como por favor, obrigada e com licença.

ATIVAÇÃO:
- SALVE! é a ativação principal.
- Respeite a personalização da palavra de ativação.
- Não altere configurações do aplicativo por conta própria.

MISSÃO:
Ajudar entregadores com:
- Ganhos e despesas.
- Metas financeiras.
- Controle de entregas.
- Rotas e navegação.
- Veículos e manutenção.
- Organização financeira.
- Produtividade e rotina.

SEGURANÇA:
- Nunca invente valores financeiros.
- Nunca invente registros ou operações.
- Não diga que salvou informações sem confirmação do aplicativo.
- Não solicite senhas, tokens ou chaves secretas.
- Não afirme que realizou pagamentos ou transferências.
- Peça confirmação antes de ações importantes.
- Diferencie orientação de execução real.
- Não afirme possuir acesso a funções não integradas.

COMUNICAÇÃO:
- Responda de maneira clara e natural.
- Evite respostas excessivamente longas.
- Explique assuntos técnicos de maneira simples.
- Ajude passo a passo.
- Seja transparente quando não souber algo.
- Adapte o tamanho da resposta à necessidade do usuário.

Seu objetivo é tornar o dia a dia do entregador mais simples.
`;

// SEGURANÇA
app.use(helmet());

app.use(cors({
  origin(origin, callback) {
    if (!origin) {
      return callback(null, true);
    }

    const normalized = origin.replace(/\/$/, "");

    if (allowedOrigins.includes(normalized)) {
      return callback(null, true);
    }

    return callback(new Error("Origem não autorizada"));
  },
  methods: ["GET", "POST", "OPTIONS"],
  allowedHeaders: ["Content-Type"],
  optionsSuccessStatus: 204
}));

app.use(express.json({
  limit: "100kb"
}));

// LIMITADOR DE REQUISIÇÕES
const limiter = rateLimit({
  windowMs: 60 * 1000,
  limit: 20,
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    error: "Você enviou muitas mensagens. Aguarde um instante."
  }
});

app.use("/api/chat", limiter);

// PÁGINA INICIAL
app.get("/", (req, res) => {
  res.json({
    app: "Meu Corre",
    assistant: "SALVE",
    status: "online",
    version: "1.1.0"
  });
});

// VERIFICAÇÃO DO SERVIDOR
app.get("/health", (req, res) => {
  const configured = Boolean(client && MODEL);

  res.status(configured ? 200 : 503).json({
    status: configured ? "ok" : "configuration_required",
    assistant: "SALVE",
    openai: client ? "configured" : "not_configured",
    model: MODEL ? "configured" : "not_configured"
  });
});

// CONVERSA COM A SALVE
app.post("/api/chat", async (req, res) => {
  try {
    if (!client || !MODEL) {
      return res.status(503).json({
        error: "A inteligência artificial ainda não foi configurada."
      });
    }

    const messages = req.body?.messages;

    if (
      !Array.isArray(messages) ||
      messages.length === 0 ||
      messages.length > 20
    ) {
      return res.status(400).json({
        error: "Envie entre 1 e 20 mensagens."
      });
    }

    const validMessages = messages.every(message =>
      message &&
      typeof message === "object" &&
      !Array.isArray(message) &&
      ["user", "assistant"].includes(message.role) &&
      typeof message.content === "string" &&
      message.content.trim().length > 0 &&
      message.content.length <= 4000
    );

    if (!validMessages) {
      return res.status(400).json({
        error: "Formato de mensagem inválido."
      });
    }

    const input = messages.map(message => ({
      role: message.role,
      content: message.content.trim()
    }));

    const response = await client.responses.create({
      model: MODEL,
      instructions,
      input,
      max_output_tokens: 1200,
      store: false
    });

    const reply = response.output_text?.trim();

    if (!reply) {
      return res.status(502).json({
        error: "A SALVE não conseguiu gerar uma resposta."
      });
    }

    return res.status(200).json({
      assistant: "SALVE",
      reply
    });

  } catch (error) {
    console.error("Erro na SALVE:", {
      status: error.status || 500,
      code: error.code || "unknown",
      message: error.message
    });

    if (error.status === 429) {
      return res.status(429).json({
        error: "Aguarde um instante antes de enviar outra mensagem."
      });
    }

    if (error.status === 401) {
      return res.status(503).json({
        error: "Verifique a configuração da chave de inteligência artificial."
      });
    }

    if (error.status === 404) {
      return res.status(502).json({
        error: "Modelo não encontrado. Verifique OPENAI_MODEL."
      });
    }

    if (
      error.name === "APIConnectionTimeoutError" ||
      error.name === "APIConnectionError"
    ) {
      return res.status(504).json({
        error: "A SALVE demorou para responder. Tente novamente."
      });
    }

    return res.status(500).json({
      error: "Não consegui conversar agora. Tente novamente."
    });
  }
});

// TRATAMENTO GERAL DE ERROS
app.use((error, req, res, next) => {
  if (res.headersSent) {
    return next(error);
  }

  if (error.message === "Origem não autorizada") {
    return res.status(403).json({
      error: "Origem não autorizada."
    });
  }

  if (error.type === "entity.too.large") {
    return res.status(413).json({
      error: "Mensagem muito grande."
    });
  }

  if (error.type === "entity.parse.failed") {
    return res.status(400).json({
      error: "JSON inválido."
    });
  }

  console.error("Erro no servidor:", error.message);

  return res.status(500).json({
    error: "Erro interno do servidor."
  });
});

// INICIALIZAÇÃO
app.listen(PORT, "0.0.0.0", () => {
  console.log("--------------------------------");
  console.log("MEU CORRE - SALVE");
  console.log("Servidor online na porta " + PORT);
  console.log("OpenAI:", client && MODEL ? "Configurada" : "Pendente");
  console.log("Origens autorizadas:", allowedOrigins.length);
  console.log("--------------------------------");
});
